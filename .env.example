# CodeVerse AI - Environment Configuration Example
# Copy this file to .env and configure your preferences

# Application Server Settings
PORT=5000
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# AI API Providers (Leave empty to use intelligent offline demo mode)
# 1. Google Gemini (Recommended for fast streaming & high quality)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenAI or OpenAI-Compatible API (e.g., Groq, OpenRouter, Ollama)
# Get a key at: https://platform.openai.com/ or https://groq.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# C++ Compiler & Sandboxed Execution Configuration
# If you have MinGW, GCC, Clang, or MSVC installed, set the path or leave empty to auto-detect from PATH
CPP_COMPILER_PATH=
EXECUTION_TIMEOUT=5

# Optional Remote Compiler Service (e.g. Judge0 CE or self-hosted Piston)
COMPILER_API_URL=
COMPILER_API_KEY=
